{
  "name": "crivelo",
  "version": "0.0.0",
  "private": true,
  "description": "Crivelo — umbrella monorepo for the coffee-community tool family (Crema Arena by Crivelo, and siblings).",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "^5.6.3"
  }
}
