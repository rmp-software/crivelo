# Database — for local dev, start the Postgres container with `docker compose up -d`
# (defaults match this URL). Prod URL belongs in Vercel env vars, never in .env.
DATABASE_URL="postgresql://crema:crema_dev@localhost:5432/crema_arena?schema=public"

# Auth.js (NextAuth v5) — generate with `openssl rand -base64 32`.
# v5 reads AUTH_SECRET from the env automatically. On Vercel, AUTH_URL is inferred;
# set it only for other hosts / local non-3000 ports.
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Admin User (created on seed)
ADMIN_EMAIL="admin@crema-arena.com"
ADMIN_PASSWORD="admin123"
