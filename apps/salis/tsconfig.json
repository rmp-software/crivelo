{
  "extends": "@crivelo/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    },
    // scripts/import-content.ts runs on `node` directly — Node 24 strips types
    // natively, which requires relative imports to carry an explicit .ts
    // extension. Safe here because the project is noEmit.
    "allowImportingTsExtensions": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
