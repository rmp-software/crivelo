{
  "extends": "@crivelo/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    },
    // scripts/import-content.ts runs on `node` directly — Node 24 strips types
    // natively, which requires relative imports to carry an explicit .ts
    // extension. Safe here because the project is noEmit.
    "allowImportingTsExtensions": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // app/sw.ts is the ServiceWorker entry: it is checked under WebWorker libs by
  // tsconfig.worker.json instead (see the type-check script), and would fail here
  // because the DOM lib's `self` is a Window.
  "exclude": ["node_modules", "app/sw.ts"]
}
